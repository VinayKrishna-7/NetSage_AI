# ==============================================================================
# NetSage AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' to configure your environment:
#   copy .env.example .env   (Windows Command Prompt)
#   cp .env.example .env     (Linux / macOS / PowerShell)
#
# IMPORTANT:
# - Never commit your real '.env' file containing secrets to version control.
# - The application defaults to 'mock' mode so NO API KEY is required for viva/demos.
# ==============================================================================

# Operation Mode: 'mock' (default, offline, zero-cost) or 'api' (requires LLM API key)
NETSAGE_MODE=mock

# OpenAI API Key (Only required if NETSAGE_MODE=api)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Name (Optional, defaults to gpt-4o-mini or similar student-friendly model)
NETSAGE_MODEL=gpt-4o-mini
